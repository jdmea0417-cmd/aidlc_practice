# 이 파일만 저장소에 둔다. 실제 값이 든 .env 는 커밋하지 않는다 (BR6.4).
# 값 자리에 실제 키를 닮은 더미를 넣지 않는다 — 스캐너 경보가 무시되기 시작한다.

# 분석 모드. 미설정·빈 값·모르는 값이면 mock 으로 동작한다 (BR1.1).
# live 로 두려면 아래 키 두 개가 모두 있어야 하고, 없으면 기동을 거부한다 (BR1.2).
ANALYSIS_MODE=mock

# 저장소 연결 문자열
DATABASE_URL=postgresql+psycopg://scd:scd_local_dev@localhost:5432/scd_coach

# 제공자 키 — 제공자가 아직 정해지지 않았으므로 비워 둔다 (D2).
# 값을 넣을 때는 <발급받은-키> 자리에 실제 키를 넣되 이 파일이 아니라 .env 에 넣는다.
STT_API_KEY=
LLM_API_KEY=

# 업로드
UPLOAD_MAX_BYTES=26214400
UPLOAD_STORAGE_PATH=storage/audio

# 제공자 호출
PROVIDER_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_READ_TIMEOUT_SECONDS=60
PROVIDER_RETRY_COUNT=1

# 운영 파라미터
AUDIO_RETENTION_DAYS=30
RECORDING_MAX_SECONDS=300
MIN_OPPORTUNITIES=3
MOCK_ANALYSIS_TARGET_SECONDS=3

# 로그와 헬스체크
LOG_LEVEL=INFO
HEALTH_CHECK_QUERY_TIMEOUT_SECONDS=1
